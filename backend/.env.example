# MongoDB
DBCONNECTION=mongodb://127.0.0.1:27017/mobirehab

# --- Payment mode (local default: mock = instant “success”, no Flutterwave call)
# For real checkout + ngrok, set USE_REAL_PAYMENT=true and complete steps in docs/LOCAL_FLUTTERWAVE_PAYMENT.md

USE_REAL_PAYMENT=false
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Public URL of THIS API (ngrok HTTPS). Required for local real pay — Flutterwave cannot call localhost.
PUBLIC_BACKEND_URL=https://YOUR-ID.ngrok-free.app

# Where the user’s browser should go after pay (Vite dev server).
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Recommended when using ngrok so req.protocol is https for generated links.
TRUST_PROXY=1

# Optional: production-like behavior without USE_REAL_PAYMENT
# NODE_ENV=production

# Therapist signup: skip email / OTP entirely (recommended; on Azure add this same name/value under Mobirehab → Configuration → Application settings).
SKIP_THERAPIST_EMAIL_OTP=true
# Optional: if you keep OTP but SendGrid fails, use THERAPIST_SIGNUP_ALLOW_NO_EMAIL=true instead of 502.
# THERAPIST_SIGNUP_ALLOW_NO_EMAIL=true
#
# Therapist documents: if Cloudinary env vars are missing, or NODE_ENV is not production, or
# ALLOW_LOCAL_SIGNUP_UPLOADS=true — failed/missing Cloudinary uses backend/uploads (no 503).
# ALLOW_LOCAL_SIGNUP_UPLOADS=true
