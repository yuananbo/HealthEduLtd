# MongoDB
DBCONNECTION=mongodb://127.0.0.1:27017/mobirehab

# --- Payment mode (local default: mock = instant “success”, no Flutterwave call)
# For real checkout + ngrok, set USE_REAL_PAYMENT=true and complete steps in docs/LOCAL_FLUTTERWAVE_PAYMENT.md

USE_REAL_PAYMENT=false
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Public URL of THIS API (ngrok HTTPS). Required for local real pay — Flutterwave cannot call localhost.
PUBLIC_BACKEND_URL=https://YOUR-ID.ngrok-free.app

# Where the user’s browser should go after pay (Vite dev server).
FRONTEND_URL=http://localhost:5173

# Recommended when using ngrok so req.protocol is https for generated links.
TRUST_PROXY=1

# Optional: production-like behavior without USE_REAL_PAYMENT
# NODE_ENV=production
